# Config file for the SoDaUtils package.
# Usage: find_package(SoDaUtils REQUIRED)
# Provides imported target: SoDaUtils::sodautils

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)
find_dependency(OpenSSL REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/SoDaUtilsTargets.cmake")

set(SoDaUtils_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(SoDaUtils_LIBRARY_DIR "${PACKAGE_PREFIX_DIR}/lib")
set(SoDaUtils_LIBRARIES SoDaUtils::sodautils)
set(SoDaUtils_FOUND TRUE)
