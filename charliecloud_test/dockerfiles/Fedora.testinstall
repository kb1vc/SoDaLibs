ARG FEDORA_VERSION=45
FROM fedora:${FEDORA_VERSION}

ARG PACKAGE_NAME

RUN dnf --assumeyes update \
 && dnf --assumeyes install cmake make gcc-c++

# /mnt/pkg is a bind mount of the host packages/ directory.
RUN test -n "${PACKAGE_NAME}" && test -f "/mnt/pkg/${PACKAGE_NAME}"
RUN dnf --assumeyes install "/mnt/pkg/${PACKAGE_NAME}"

# Sanity check: ask the package what files it installed, and verify each
# one actually exists on disk.  This avoids baking distro-specific paths
# (lib64 vs lib, SoDa/ subdir, etc.) into the test.
RUN rpm -q sodalibs-devel
RUN set -eu; \
    missing=""; \
    for f in $(rpm -ql sodalibs-devel); do \
        [ -e "$f" ] || missing="$missing $f"; \
    done; \
    if [ -n "$missing" ]; then \
        echo "MISSING FILES:" >&2; \
        printf '  %s\n' $missing >&2; \
        exit 1; \
    fi; \
    echo "all package files present"
