ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential git cmake pkg-config \
        libfftw3-dev libssl-dev \
        file \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /build
WORKDIR /build

# /mnt/src is a bind mount of the host SoDaLibs working tree.
RUN git clone /mnt/src /build/SoDaLibs \
 && cd /build/SoDaLibs \
 && git checkout dist-test

WORKDIR /build/SoDaLibs/build
RUN cmake -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_DEB=ON ../
RUN make -j"$(nproc)"
RUN ctest --output-on-failure
RUN make install
RUN cpack -G DEB
RUN mkdir -p /mnt/out && cp *.deb /mnt/out/
