# Config file for the SoDaSignals package.
# Usage: find_package(SoDaSignals REQUIRED)
# Provides imported target: SoDaSignals::sodasignals

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Ensure our install prefix is searched when locating dependencies
# installed alongside this package (SoDaUtils, SoDa_FFTW).
list(INSERT CMAKE_PREFIX_PATH 0 "${PACKAGE_PREFIX_DIR}")

find_dependency(SoDaUtils REQUIRED)
find_dependency(SoDa_FFTW REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/SoDaSignalsTargets.cmake")

set(SoDaSignals_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(SoDaSignals_LIBRARY_DIR "${PACKAGE_PREFIX_DIR}/lib")
set(SoDaSignals_LIBRARIES SoDaSignals::sodasignals)
set(SoDaSignals_FOUND TRUE)
